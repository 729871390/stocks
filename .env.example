# 复制为 .env 后填写（docker compose 自动读取）

# 必填：管理密码（源管理、任务、watchlist 等全部功能）
ADMIN_PASSWORD=

# 选填：给朋友的只读访客密码（只能浏览信息流与日报）
VIEWER_PASSWORD=

# LLM 二选一（都填则默认用 Anthropic，可用 LLM_PROVIDER 强制指定）：
# Anthropic API Key
ANTHROPIC_API_KEY=
# Google Gemini API Key（在 aistudio.google.com 免费申请，有免费额度，零成本起步）
GEMINI_API_KEY=
# 选填：强制供应商 anthropic | gemini（默认 auto 按已填的 key 自动选）
LLM_PROVIDER=

# 部署后的对外地址（推送消息里的链接、短链用它拼接）
# 例：https://info.example.com 或 http://服务器IP:8787
PUBLIC_BASE_URL=http://localhost:8787

# 选填：会话签名密钥（不填则从密码派生；改密码即全员下线）
SESSION_SECRET=

# 选填：HTTPS 模式的域名（docker compose --profile https 时必填）
DOMAIN=

# 选填：对外端口（默认 8787）
PORT=8787
